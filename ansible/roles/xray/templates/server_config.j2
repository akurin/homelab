{
  "log": {
    "loglevel": "info"
  },
  "dns": {
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "skipFallback": false
      }
    ]
  },

  {% if reverse_xray_role is defined and reverse_xray_role == 'portal' %}
  "reverse": {
    "portals": [
      {
        "tag": "portal",
        "domain": "reverse-proxy.xray.internal"
      }
    ]
  },
  {% elif reverse_xray_role is defined and reverse_xray_role == 'bridge' %}
  "reverse": {
    "bridges": [
      {
        "tag": "bridge",
        "domain": "reverse-proxy.xray.internal"
      }
    ]
  },
  {% endif %}

  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "1.1.1.1"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "incoming_xhttp"
        ],
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      }
      {% for rule in local_exit_rules | default([]) %}
      ,{{ rule | to_json }}
      {% endfor %}
      {% if reverse_xray_role is defined and reverse_xray_role == 'portal' %}
      ,
      {
        "type": "field",
        "inboundTag": [
          "incoming_xhttp"
        ],
        "outboundTag": "portal"
      }
      {% elif reverse_xray_role is defined and reverse_xray_role == 'bridge' %}
      ,
      {
        "type": "field",
        "inboundTag": [
          "bridge"
        ],
        "domain": [
          "full:reverse-proxy.xray.internal"
        ],
        "outboundTag": "next_proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "bridge"
        ],
        "outboundTag": "direct"
      }
      {% endif %}
    ]
  },

  "inbounds": [
    {
      "port": {{ xray_xhttp_port_internal }},
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
{% for user in xray_users %}
          {
            "id": "{{ user.id }}",
            "email": "{{ user.name }}@{{ inventory_hostname }}"
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {{ {
          "mode": "packet-up",
          "path": xray_xhttp_path
        } | combine(xray_xhttp_extra_settings | default({})) | to_json }}
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "tag": "incoming_xhttp"
    }
  ],

  {# Xray sends traffic that matches no routing rule to the FIRST outbound,
     so xray_default_outbound (resolved in tasks/main.yml) is rendered first. #}
{% set outbounds = [] %}
{% if next_address is defined and next_address %}
{% set ob %}
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ next_address }}",
            "port": 443,
            "users": [
              {
                "id": "{{ xray_client_user.id }}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {{ {
          "path": xray_xhttp_path,
          "mode": "packet-up"
        } | combine(next_address_xray_xhttp_extra_settings) | to_json }},
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "h2"
          ],
          "fingerprint": "safari"
        }
      },
      "tag": "next_proxy"
    }
{% endset %}
{% set _ = outbounds.append({'tag': 'next_proxy', 'json': ob}) %}
{% endif %}
{% if warp_outbound_enabled | default(false) %}
{% set ob %}
    {
      "protocol": "wireguard",
      "settings": {
        "secretKey": "{{ warp_secret_key }}",
        "domainStrategy": "ForceIPv4v6",
        "address": [
          "{{ warp_ipv4 }}",
          "{{ warp_ipv6 }}"
        ],
        "peers": [
          {
            "publicKey": "{{ warp_public_key }}",
            "allowedIPs": [
              "0.0.0.0/0",
              "::/0"
            ],
            "endpoint": "{{ warp_endpoint }}:2408"
          }
        ],
        "reserved": {{ warp_reserved | to_json }},
        "mtu": 1280,
        "noKernelTun": true
      },
      "tag": "warp"
    }
{% endset %}
{% set _ = outbounds.append({'tag': 'warp', 'json': ob}) %}
{% endif %}
{% if protonvpn_config_name is defined and protonvpn_config_name %}
{% set ob %}
    {
      "protocol": "wireguard",
      "settings": {
        "secretKey": "{{ protonvpn_config.private_key }}",
        "domainStrategy": "ForceIPv4v6",
        "address": {{ protonvpn_config.address | to_json }},
        "peers": [
          {
            "publicKey": "{{ protonvpn_config.public_key }}",
            "allowedIPs": {{ protonvpn_config.allowed_ips | default(["0.0.0.0/0", "::/0"]) | to_json }},
            "endpoint": "{{ protonvpn_config.endpoint }}",
            "keepAlive": {{ protonvpn_config.persistent_keepalive | default(25) }}
          }
        ],
        "mtu": 1280,
        "noKernelTun": true
      },
      "tag": "protonvpn"
    }
{% endset %}
{% set _ = outbounds.append({'tag': 'protonvpn', 'json': ob}) %}
{% endif %}
{% set _ = outbounds.append({'tag': 'direct', 'json': '{"protocol": "freedom", "tag": "direct"}'}) %}
{% set _ = outbounds.append({'tag': 'block', 'json': '{"protocol": "blackhole", "tag": "block"}'}) %}
  "outbounds": [
    {% for ob in (outbounds | selectattr('tag', 'equalto', xray_default_outbound) | list)
                + (outbounds | rejectattr('tag', 'equalto', xray_default_outbound) | list) %}
    {{ ob.json }}{% if not loop.last %},{% endif %}

    {% endfor %}
  ]
}
