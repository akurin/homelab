node-name: "{{ inventory_hostname }}"
token: "{{ K3S_TOKEN }}"
node-external-ip: {{ k3s_node_external_ip | to_json }}
# Advertise the overlay, not the public address: agents learn the API endpoint from this, and a
# NAT'd node cannot reach the public address. tls-san still lists the public IP so the serving
# certificate remains valid for it.
advertise-address: {{ amneziawg_address | to_json }}
flannel-iface: {{ k3s_flannel_iface | to_json }}
flannel-backend: host-gw
flannel-external-ip: {{ k3s_flannel_external_ip | bool | lower }}
cluster-cidr: "{{ k3s_pod_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
disable-cloud-controller: true
tls-san:
  - "{{ inventory_hostname }}"
  - {{ ansible_host | to_json }}
  - {{ amneziawg_address | to_json }}
