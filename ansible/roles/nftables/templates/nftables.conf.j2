#!/usr/sbin/nft -f

{% if nftables_full_flush %}
flush ruleset
{% else %}
# Scoped flush — leaves other tables (container networking, NAT) intact
table inet filter {}
delete table inet filter
{% endif %}

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif "lo" accept
    ct state established,related accept

{% if nftables_trusted_sources | length > 0 %}
    ip saddr { {{ nftables_trusted_sources | join(', ') }} } accept
{% endif %}
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

{% if nftables_allowed_tcp | length > 0 %}
    tcp dport { {{ nftables_allowed_tcp | join(', ') }} } accept
{% endif %}
{% if nftables_allowed_udp | length > 0 %}
    udp dport { {{ nftables_allowed_udp | join(', ') }} } accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
