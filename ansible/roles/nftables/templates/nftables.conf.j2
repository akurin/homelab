#!/usr/sbin/nft -f

{% if nftables_full_flush %}
flush ruleset
{% else %}
# Scoped flush — preserves iptables-nft rules used by K3s CNI/NAT
table inet filter {}
delete table inet filter
{% endif %}

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif "lo" accept
    ct state established,related accept

{% for iface in nftables_trusted_ifaces | default([]) %}
    iif "{{ iface }}" accept
{% endfor %}
{% if nftables_trusted_sources | default([]) | length > 0 %}
    ip saddr { {{ nftables_trusted_sources | join(', ') }} } accept
{% endif %}
{% for entry in nftables_trusted_source_groups | default([]) %}
{% for peer in groups[entry.group] | default([]) %}
{% if entry.tcp | default([]) | length > 0 %}
    ip saddr {{ hostvars[peer]['ansible_host'] }} tcp dport { {{ entry.tcp | join(', ') }} } accept
{% endif %}
{% if entry.udp | default([]) | length > 0 %}
    ip saddr {{ hostvars[peer]['ansible_host'] }} udp dport { {{ entry.udp | join(', ') }} } accept
{% endif %}
{% endfor %}
{% endfor %}
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

{% if nftables_allowed_tcp | length > 0 %}
    tcp dport { {{ nftables_allowed_tcp | join(', ') }} } accept
{% endif %}
{% if nftables_allowed_udp | length > 0 %}
    udp dport { {{ nftables_allowed_udp | join(', ') }} } accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
