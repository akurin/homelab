[Unit]
Description=SSH auth tripwire (new key/IP detection -> Telegram)
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
User=ssh-alert
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/ssh-alert.py
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ssh-alert
EnvironmentFile=/etc/ssh-alert/env

[Install]
WantedBy=multi-user.target
